000000r 1               	 .MACPACK atari
000000r 2               ; Convert characters to screen codes
000000r 2               
000000r 2               ; Helper macro that converts and outputs one character
000000r 2               .macro _scrcode char
000000r 2                       .if (char >= 0) .and (char <= 31)
000000r 2                               .byte   (char + 64)
000000r 2                       .elseif (char >= 32) .and (char <= 95)
000000r 2                               .byte   (char - 32)
000000r 2                       .elseif (char >= 96) .and (char <= 127)
000000r 2                               .byte   char
000000r 2                       .elseif (char >= 128) .and (char <= 159)
000000r 2                               .byte   (char + 64)
000000r 2                       .elseif (char >= 160) .and (char <= 223)
000000r 2                               .byte   (char - 32)
000000r 2                       .elseif (char >= 224) .and (char <= 255)
000000r 2                               .byte   char
000000r 2                       .else
000000r 2                               .error  "scrcode: Character constant out of range"
000000r 2                       .endif
000000r 2               .endmacro
000000r 2               
000000r 2               .macro  scrcode arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8, arg9
000000r 2               
000000r 2                       ; Bail out if next argument is empty
000000r 2                       .if     .blank (arg1)
000000r 2                               .exitmacro
000000r 2                       .endif
000000r 2               
000000r 2                       ; Check for a string
000000r 2                       .if     .match ({arg1}, "")
000000r 2               
000000r 2                               ; Walk over all string chars
000000r 2                               .repeat .strlen (arg1), i
000000r 2                                       _scrcode        {.strat (arg1, i)}
000000r 2                               .endrepeat
000000r 2               
000000r 2                       ; Check for a number
000000r 2                       .elseif .match (.left (1, {arg1}), 0)
000000r 2               
000000r 2                               ; Just output the number
000000r 2                               _scrcode        arg1
000000r 2               
000000r 2                       ; Check for a character
000000r 2                       .elseif .match (.left (1, {arg1}), 'a')
000000r 2               
000000r 2                               ; Just output the character
000000r 2                               _scrcode        arg1
000000r 2               
000000r 2                       ; Anything else is an error
000000r 2                       .else
000000r 2               
000000r 2                               .error  "scrcode: invalid argument type"
000000r 2               
000000r 2                       .endif
000000r 2               
000000r 2                       ; Call the macro recursively with the remaining args
000000r 2                       scrcode arg2, arg3, arg4, arg5, arg6, arg7, arg8, arg9
000000r 2               .endmacro
000000r 2               
000000r 2               
