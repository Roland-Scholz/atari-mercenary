;------------------------------------------------------------
; Restart here after CTRL-Q
; - scatter objects in inventory over Targ
; - set player Y-pos to $000080
; - set OUTDOOR
; - give Dominion Dart
; - set walking yaw to $10
; - reset colors
; - set players X and Z pos to Targ bounds 15-15
; - set speed to zero
;------------------------------------------------------------	    
L2996:		jsr SCATTER_INVENTORY_L2A75
		lda #$80
		sta L0083
		lda #$80
		sta CUR_Y_LSB_73
		lda #$00
		sta CUR_Y_MSB_74
		sta CUR_Y_HSB_75
		sta PLANET_UNDERGROUND_A6				;outddors
		sta L00CD
		lda #$01						;set Dominion Dart
		sta CRAFT_ID_WALKING_A7
		jsr COPY_SHIP_DATA_L4189				;copy ship data
			
		lda #$10
		sta YAW_WALK_AA
			
		jsr SET_COLORS_L5921
			
