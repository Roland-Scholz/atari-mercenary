;------------------------------------------------------------
;
;X1			X2							X3
;Y1			Y2							Y3	
;Z1			Z2							Z3	
;
;cos(pit)*sin(yaw)	cos(rol)*sin(pit)*sin(yaw) + sin(rol)*cos(yaw)		sin(rol)*sin(pit)*sin(yaw) + cos(rol)*cos(yaw)
;sin(pit)		cos(rol)*cos(pit)					-sin(rol)*cos(pit)
;cos(pit)*cos(yaw)	-sin(rol)*sin(yaw) - cos(rol)*sin(pitch)*cos(yaw)	sin(rol)*sin(pit)*cos(yaw) - cos(rol)*sin(yaw)
;
;------------------------------------------------------------	    
SETUP_ROTATION_MATRIX_L4708: 

		lda LIFT_UP_DOWN_CA				;$80 lift down, $01 lift up
