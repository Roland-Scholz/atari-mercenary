		stx MUL_LO_06
		sty MUL_HI_07
		ldx SIN_YAW_LO_3A
		lda SIN_YAW_HI_3B
		eor #$01					; REVERSE SIGN       
		tay
		jsr FP_MUL_L4DD8				; - ROLL_COS * SIN_YAW

		ldx ZP_08
		ldy ZP_09
		jsr FP_ADD_L4E59
		stx ROTATE_MZ3_LO_42				;MZ3 = sin(rol)*sin(pit)*cos(yaw) - cos(rol)*sin(yaw)
		tya
