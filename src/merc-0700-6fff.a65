		stx ROTATE_MY3_LO_40				; MY3 = -sin(rol)*cos(pit)
		sta ROTATE_MY3_HI_41
		
		sta MUL_HI_07
		ldx L008A
		ldy L008B
		jsr FP_MUL_L4DD8				
		tya
		eor #$01					; REVERSE SIGN
		sta MUL_HI_07
		jsr FP_TO_8BIT_4F45
		clc
