		stx ZP_08
		sta ZP_09
		
		ldx SIN_ROLL_LO_2C				
		ldy SIN_ROLL_HI_2D
		stx MUL_LO_06
		sty MUL_HI_07
		ldx COS_YAW_LO_3C
		ldy COS_YAW_HI_3D
		jsr FP_MUL_L4DD8				;ROLL_SIN * YAW_COS
		ldx ZP_08
		ldy ZP_09
		jsr FP_ADD_L4E59
		stx ROTATE_MX2_LO_44				;MX2 = cos(rol)*sin(pit)*sin(yaw) + sin(rol)*cos(yaw)
		sty ROTATE_MX2_HI_45
		
		ldx COS_ROLL_LO_2E
		ldy COS_ROLL_HI_2F
		stx MUL_LO_06
		sty MUL_HI_07
