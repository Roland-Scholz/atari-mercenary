		sta CHUNK_PTR_HI_B1				;hi-byte from caller
		lda GAME_MEM_LEN_L5C11+1,Y			;lo-byte ptr from table
		sta CHUNK_PTR_LO_B0
		lda GAME_MEM_LEN_L5C11+2,Y
