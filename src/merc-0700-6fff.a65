		jsr L37ED
		jmp MAIN_LOOP_L29DF

;------------------------------------------------------------
; MAIN_LOOP_L29DF
;------------------------------------------------------------
MAIN_LOOP_L29DF:
		jsr BENSON_L2F33				; process benson messages
		jsr INTERSTELLAR_SHIP_DELIVERY_L2AB7            ; has the interstellar ship been delivered
		lda PLANET_UNDERGROUND_A6                    	; is the player above or below ground
		beq OUTSIDE_L2A24                               ; player is above ground
		jsr SETUP_ROTATION_L492C                        ; setup sin and cos variables for roll and pitch and yaw (and also for $99)?				
		jsr DRAW_SCREEN_OUTDOOR_L559D                   ; draw ground and sky
		lda PLANET_UNDERGROUND_A6                    
		beq OUTSIDE_L2A24                               
		jsr L3817                                       
		beq INSIDE_L2A0C                                
		lda L00AF                                       
		bne INSIDE_L2A0C                                
		jsr L38AD                                       
		bcc INSIDE_L2A0C                                
		jsr SETUP_ROOM_L353C                            
		lda PLANET_UNDERGROUND_A6                    
		beq L2A33                                       
		lda #$02                                        
		sta L00AF                                       
	                                                        
;------------------------------------------------------------
; MAIN_LOOP_INSIDE
;------------------------------------------------------------
INSIDE_L2A0C:                                                   
		jsr ROTATE_GROUND_STRUCTURE_L3B49               ; rotate around x - underground (A8=1)
		jsr BLACK_LINES_L53BD                           ; setup black lines to draw
		jsr DRAW_STRUCTURE_L3B58                        ; draw the room
		jsr WHITE_LINES_L53B7                           ; setup white lines
		jsr DRAW_OBJECTS_L3B77                          ; draw the objects
		jsr JOYSTICK_L5957                              ;
		jsr L4555                                       ; lift
		jmp MAIN_LOOP_L29DF                             ; next loop
	          
;------------------------------------------------------------
; MAIN_LOOP_OUTSIDE
;------------------------------------------------------------		  
OUTSIDE_L2A24:                                                  
		jsr SETUP_ROTATION_L492C                        ; walking or flying OUTSIDE ; setup sin and cos variables for roll and pitch and yaw (and also for $99)?	
		jsr L3951                                       
		jsr SETUP_ROTATION_MATRIX_L4708                 ; setup rotation matrix
		jsr ROTATE_GROUND_STRUC_L489A			; locally rotating object? ($3 pyramid 08-08, $10 radar 00-14, 00-10, $06 cube 12-03)
		jsr DRAW_SCREEN_OUTDOOR_L559D                   ; draw ground and sky
L2A33:		jsr DRAW_MAP_LINES_L34D2                        ; draw map lines 
L2A36:		lda GROUND_STRUC_OBJ_TO_DRAW_B5       
		beq L2A48                                       ; no ground structure to draw?    
		lda LIFT_UP_DOWN_CA                                       ; ?
		bne L2A42                                       ; ?
		lda CUR_Y_HSB_75                                ; if this is less than 0
		bne L2A48                                       ; then
L2A42:		jsr ROTATE_GROUND_STRUCTURE_L3B49               ; rotate ground structure
		jsr DRAW_STRUCTURE_L3B58                        ; draw ground structure
L2A48:		inc OBJ_Z_MSB_L6500                             ; flying ship at edge of city
		bne L2A58                                       
		inc OBJ_Z_HSB_L65C0                             ; flying ship at edge of city
		lda OBJ_Z_HSB_L65C0                             ; flying ship at edge of city
		and #$0F                                        ; flying ship at edge of city
		sta OBJ_Z_HSB_L65C0                             ; flying ship at edge of city
L2A58:		jsr WHITE_LINES_L53B7                           ; setup white lines
		jsr DRAW_OBJECTS_L3B77                          ; draw objects
		jsr JOYSTICK_L5957                              
		jsr L4555                                       ; lift
		lda #$30                                        ;
		jsr L2CEE                                       ;
		jsr L2C19                                       ;
		jsr L2B13                                       ;
		jsr L2DA4                                       ;
		jmp MAIN_LOOP_L29DF                             ; next loop
		
