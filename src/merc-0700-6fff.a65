;------------------------------------------------------------
; Joystick und keyboard input
;------------------------------------------------------------
JOYSTICK_L5957:
		lda TRIG0	
		sta FIRE_7F
		lda PORTA
		and #$0F
		sta JOYA_7E
		clc
		adc FIRE_7F
		cmp #$10
		beq L5972					;nothing pressed (15 + 1)

		lda #$80					;otherwise
		ora L293B					;set bit 7 in L293B
		sta L293B
		
L5972:		ldy NEW_KEY_L00E9
		ldx LAST_KEY_L00EA
		cpy #$8C					; 'CTRL-Return'
		beq L5972

		cpy #$3A					; 'D' key pressed     
		bne L5984
		jsr RESET_KEY_L5AEE
		jmp L3D6F
		
L5984:		cpy #$00					; 'L' key pressed 
		bne L5991
		jsr RESET_KEY_L5AEE
		jsr L5AF7
		jmp L3D39
		
L5991:		cpx #$36					; '<' key pressed 
		bne L599C
		ldx #$F8
		ldy #$FC
		jmp L5AD5
		
L599C:		cpx #$37					; '>' key pressed 
		bne L59A7
