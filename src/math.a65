OVERFLOW	=	$E000

FPTO16BIT:	TYA					; input X/Y (mantisa/exponent) -  output X=HI/Y=LO	; transfer exponent? to a
		BMI 	b8501 		; if negative
		LSR 				; half and put bit into carry
		LSR 				; half and put bit into carry
		CMP 	#15			; is it greater than 15
		BCS 	FP8BIT_ERR		; yes so error so exit with carry set
		STA 	save_msb		; store intermediate in temp var
		ASL 				; *2
		ADC 	save_msb		; *3 
		STA 	FP16BIT_JMP +1	; number of bytes to jump
		LDA 	#0
		STA 	save_msb		; clear result
		TXA 				; get input (mantisa?)
		SEC 				; set carry to move 1 into result
		ROR 				; rotate carry into high bit and low bit into carry
		ROR 	save_msb		; rotate carry into result
FP16BIT_JMP:	BCC 	b84D2		; jump forward
		LSR 				; half and shift lowest bit into carry  
		ROR 	save_msb		; half and rotate carry bit into result
		LSR 
		ROR 	save_msb
		LSR 
		ROR 	save_msb
		LSR 
		ROR 	save_msb
		LSR 
		ROR 	save_msb
b84D2:   	LSR 
		ROR 	save_msb
		LSR 
		ROR 	save_msb
		LSR 
		ROR 	save_msb
		LSR 
		ROR	save_msb
		LSR 
		ROR 	save_msb
		LSR 
		ROR 	save_msb
		LSR 
		ROR 	save_msb
		LSR 
		ROR 	save_msb
		LSR 
		ROR 	save_msb
		LSR 
		ROR 	save_msb
		TAX 				; store low byte of result?
		TYA 				; get input (exponent?)
		LDY 	save_msb		; store high byte of result?
		LSR 				; move 1st bit of input (sign) into carry
		BCC 	b8500		; clear so positive
		TXA 			; negtive so
		EOR 	#$FF	; negate x
		TAX 
		TYA 
		EOR 	#$FF	; negate y
		TAY 
		CLC 
b8500:   	RTS 					; no

b8501: 		LSR 				; move 1st bit to carry
		BCC 	b850B		; set y/n
		LDX 	#$FF	; yes
		LDY 	#$FF
		CLC 
		RTS 
b850B:   	LDX 	#0			; no
		LDY 	#0
FP8BIT_ERR:	RTS 
			
;------------------------------------------------------------
; MATH_24BitToFP (FP.SetToObjectSpaceCoordinate24)
; Enter: A = Coordinate.MSB X = Coordinate.MSB Y = Coordinate.LSB
; Uses: save_msb  Temporary store for coordinate MSB
; Uses: save_lsb  Temporary store for coordinate MSB
; Exit:  ret_exp, ret_man  result, also stored in X:A (exp:man)
;
;------------------------------------------------------------    
BIT24TOFP:	STY	save_lsb 	
		STA 	save_msb 				; store msb
		BPL 	b8527					; positive ?
			
		LDA 	#0	 				; negative so 
		SEC 			
		SBC 	save_lsb 				; negate lsb
		STA 	save_lsb			
		TXA 						; negate psb
		EOR 	#$FF
		ADC 	#0
		TAX 
		LDA 	#0
		SBC 	save_msb				; negate msb

b8527:  	BNE 	b8538					; if msb not 0 - jump to set loop counter to 24 ($18)?
		TXA 						; move psb to a
		BNE 	b854F					; if psb not 0 - jump to set loop counter to 16 ($10)?
			
		LDA 	save_lsb				; get lsb
		BEQ 	b8553					; if lsb is 0 - jump to overflow and exit

		LDX 	#0
		STX 	save_lsb
		LDX 	#8					; set loop counter to 8?
		BNE 	b853C 					; jump?
			
b8538:   	STX 	save_lsb				; store psb?
		LDX 	#24					; set loop counter to 24?
			
b853C:   	DEX 						; find exponent - start from whatever x is passed in and reduce until x a bit set found 
		ASL 	save_lsb 				; shift lsb up into carry
		ROL 	 					; shift msb up with carry - mantisa?
		BCC 	b853C					; as soon as first bit is set then exit

		STA 	ret_man					; store mantisa?
		TXA 						; x is exponent?
		ASL 						; exponent *2?
		ASL 	save_msb				; shift msb putting sign into carry 
		ROL 						; rotate carry into first bit of exponent
		TAX 						; copy exponent to x - bit 0 is sign
		STX 	ret_exp
		LDA 	ret_man					; copy mantisa to a
		RTS

b854F:   	LDX 	#16					; set loop counter to 16?
		BNE 	b853C 					; jump?
		
b8553:   	LDA 	#<OVERFLOW
		LDX 	#>OVERFLOW
		STA 	ret_man
		STX 	ret_exp
		RTS 


;------------------------------------------------------------
; Y(hi) X(lo) * A (hi) FP_MULTIPLY_LO = A(hi) Y(lo)
;------------------------------------------------------------    
FP_MULTIPLY:	STA	mul_hi				; inputs = X-(LO) + Y-(HI) + A (HI) + FP_MULTILPLY_LO - outputs = AY
		LDA 	LOG_TABLE,X		
		LDX 	mul_lo
		CLC 
		ADC 	LOG_TABLE,X
		TAX 
		TYA 
		BCC 	_FP_MUL_CNT
		ADC 	#$03					; add 4, get sign bit right
		CLC 
_FP_MUL_CNT:	ADC 	mul_hi
		AND 	#$FD					;clear sign bit
		LDY 	EXP_TABLE,X
		RTS 

;------------------------------------------------------------
; Y(hi) X(Lo) *  mul_hi mul_lo = YX and mul_hi/mul_lo
;------------------------------------------------------------    
FPMUL:		LDA	LOG_TABLE,X
		LDX	mul_lo
		CLC	
		ADC	LOG_TABLE,X
		TAX	
		TYA	
		BCC	_PF_MUL_CNT
		ADC	#$03			; add 4?
		CLC	
_PF_MUL_CNT:   	ADC	mul_hi
		BVS	MATH_LIMIT 
		AND	#$FD
		STA	mul_hi
		TAY	
		LDA	EXP_TABLE,X
		TAX	
		STA	mul_lo
		RTS 

MATH_LIMIT:	BPL	_MATH_LIMIT_POS
		AND	#$01
		ORA	#$78
		TAY	
		LDX	#$00
		STX	mul_lo
		STY	mul_hi
		RTS	

_MATH_LIMIT_POS:
		AND #$01
		ORA #$84

MATH_LIMIT_EXIT:
		TAY 
		LDX	#$00
		STX	mul_lo
		STY 	mul_hi
		RTS 
		
		
		
LOG_TABLE:
		.BYTE $00,$01,$03,$04,$06,$07,$09,$0A
		.BYTE $0B,$0D,$0E,$10,$11,$12,$14,$15
		.BYTE $16,$18,$19,$1A,$1C,$1D,$1E,$20
		.BYTE $21,$22,$24,$25,$26,$28,$29,$2A
		.BYTE $2C,$2D,$2E,$2F,$31,$32,$33,$34
