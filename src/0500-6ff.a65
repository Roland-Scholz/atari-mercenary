;
; Start of code
;
            .org $0500
;
L0500:      lda RTCLOK+2			;code originally at $700
L0502:      cmp RTCLOK+2
            beq L0502
            ldx #$00
L0508:      lda L0700,X
            sta L0500,X
            lda L0800,X
            sta L0600,X
            dex
            bne L0508
            jmp L051A
	    	    
L051A:      lda #$06				;get scontrol here, load sector 5
            sta DBUFHI
            lda #$80
            sta DBUFLO
            lda #$05
            sta DAUX1
            jsr DSKINV
	    
            ldx #$7F				;copy protection
L052E:      lda L0500,Y
            eor L0680,X
            eor L0500,X
            eor L0580,X
            nop					;do nothing
            nop
            nop
            dey
            dex
            bpl L052E
	    
            lda L00B7				;0 = hires, $ff = low res
            bne L054D
	    
            ldx #$0C				;high res, x = $c
            jsr L0561
            jmp L1E00
	    
L054D:      ldx #$00
            jsr L0561
            lda #$00
            sta SDMCTL
            sta DMACLT
            inx
            jsr L0561
            jmp L8800
	    
L0561:      stx L00B5
            lda L05F8,X
            bne L0569
            rts

L0569:      sta DBUFHI
            lda #$00
            sta DBUFLO
            lda L05F9,X
            sta L00B4
