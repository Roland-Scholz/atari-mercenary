videoram	= SCREEN0
CURR_X_MSB	= $fe
CURR_X_HSB	= $ca

SCREEN0		= $8010
SCREEN1		= $a010
SCREEN_0 	= $80
SCREEN_1 	= $a0

rega		= $80
regx		= $81
regy		= $82
ptr		= $83
ptr1		= $85
cnt		= $87
mul_lo		= $88
mul_hi		= $89
save_msb	= $8a
save_lsb	= $8b
ret_man		= $8c
ret_exp		= $8d

		.include "os.a65"

;------------------------------------------------------------
;
;------------------------------------------------------------

		.org $2200

		jsr	miscinit
		
		sei
		lda	#0
		sta	NMIEN


		lda	#0
		tax
		tay
		sta	rega
		
fill_vertab:	sta	ver_tab_lo, x
		pha
		lda	rega
		sta	ver_tab_hi, x
		pla

		clc
		adc	#40
		bcc	fill_vertab1
		inc	rega
fill_vertab1:	inx
		cpx	#152
		bne	fill_vertab
		
		jmp	testmath

;------------------------------------------------------------
;
;------------------------------------------------------------		
		lda	#<dsplist
		sta	SDLSTL
		lda	#>dsplist
		sta	SDLSTH
		
		lda	#$0f
		sta	COLOR0
		lda	#$46
		sta	COLOR1
		lda	#$36
		sta	COLOR2
		lda	#2
		sta	COLOR3
		lda	#$12
		sta	COLOR4
		
		lda	RTCLOK+2
waitclock:	cmp	RTCLOK+2
		beq	waitclock
		
		
		ldx	#CURR_X_MSB
		lda	#CURR_X_HSB
		ldy	#0
		jsr	hex16
		
;------------------------------------------------------------
;
;------------------------------------------------------------
testmath:	
		ldy	#$AA
		ldx	#$03					;%00000011 10101010 -> $24 $D5 X=16-7=9  %00001001	%11010101
		lda	#0
		jsr	BIT24TOFP

		ldy	#$01
		ldx	#$00
		lda	#$80
		jsr	BIT24TOFP
		
		ldx	ret_man
		ldy	ret_exp
		jsr	FPTO16BIT	
		
		tya
		jsr	puthex
		txa
		jsr	puthex
		
end:		jmp	end

;
;
;
stoptr:		sta	(ptr), y
incptr:		inc	ptr
		bne	incptr1
		inc	ptr + 1
incptr1:	rts

;
;
;
hex16:		sty	regy	; Y = YPOS / A = HI / X = LO
		stx	regx		
		ldx	#0				;xpos
		jsr	hex8
		lda	regx
		ldy	regy
		inx
		jsr	hex8
		rts

hex8:		pha		; A = NUM / Y = YPOS / X = XPOS
		lsr
		lsr
		lsr
		lsr
		jsr	hexnib
		inx
		pla
		and	#15
		
hexnib:		clc		; A = NUM / Y = YPOS / X = XPOS
		adc	#<HEX0
		sta	ptr1
		lda	#>HEX0
		adc	#0
		sta	ptr1+1
		
		txa
		clc
		adc	#<SCREEN0
		adc	ver_tab_lo, y
		sta	ptr
		lda	ver_tab_hi, y
		adc	#>SCREEN0
		sta	ptr+1
		lda	#5
		sta	cnt

		tya
		pha
		
		ldy	#0
hex8_1:		lda	(ptr1), y
		sta	(ptr), y
		
		clc
		lda	ptr
		adc	#40
		sta	ptr
		bcc	*+4
		inc	ptr+1
		
		clc
		lda	ptr1
		adc	#16
		sta	ptr1
		bcc	*+4
		inc	ptr1+1
		
		dec	cnt
		bne	hex8_1
		
		pla
		tay
		rts
		
			
ver_tab_lo:	.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		
ver_tab_hi:	.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		
HEX0:		.BYTE	%00010101,%00000100,%00010101,%00010101,%00010001,%00010101,%00010101,%00010101,%00010101,%00010101,%00010101,%00010000,%00010101,%00000001,%00010101,%00010101 
HEX1:		.BYTE	%00010001,%00010100,%00000001,%00000001,%00010001,%00010000,%00010000,%00000001,%00010001,%00010001,%00010001,%00010000,%00010000,%00000001,%00010000,%00010000 
HEX2:		.BYTE	%00010001,%00000100,%00010101,%00010101,%00010101,%00010101,%00010101,%00000001,%00010101,%00010101,%00010101,%00010101,%00010000,%00010101,%00010101,%00010100
HEX3:		.BYTE	%00010001,%00000100,%00010000,%00000001,%00000001,%00000001,%00010001,%00000001,%00010001,%00000001,%00010001,%00010001,%00010000,%00010001,%00010000,%00010000
HEX4:		.BYTE	%00010101,%00010101,%00010101,%00010101,%00000001,%00010101,%00010101,%00000001,%00010101,%00010101,%00010001,%00010101,%00010101,%00010101,%00010101,%00010000
	
		.include "dsplist.a65"
		.include "misc.a65"
		.include "math.a65"
