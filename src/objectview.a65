videoram	= $8010
CURR_X_MSB	= $CA
CURR_X_HSB	= $FE

SCREEN0		= $8010
SCREEN1		= $a010
SCREEN_0 	= $80
SCREEN_1 	= $a0

rega		= $80
REGX		= $81
REGY		= $82
ptr		= $83
ptr1		= $85
cnt		= $87

		.include "os.a65"


		.org $2200

		lda	#0
		tax
		tay
		sta	rega
		
fill_vertab:	sta	ver_tab_lo, x
		pha
		lda	rega
		sta	ver_tab_hi, x
		pla

		clc
		adc	#40
		bcc	fill_vertab1
		inc	rega
fill_vertab1:	inx
		cpx	#152
		bne	fill_vertab
		
		lda	#<dsplist
		sta	SDLSTL
		lda	#>dsplist
		sta	SDLSTH

		ldx	#CURR_X_MSB
		lda	#CURR_X_HSB
		ldy	#0
		jsr	hex16
		
end:		jmp	end

;
;
;
stoptr:		sta	(ptr), y
incptr:		inc	ptr
		bne	incptr1
		inc	ptr + 1
incptr1:	rts

;
;
;
hex16:		sty	REGY	; Y = YPOS / A = HI / X = LO
		stx	REGX		
		ldx	#0
		jsr	hex8
		lda	REGX
		ldy	REGY
		ldx	#2
		jsr	hex8
		rts

hex8:		pha		; A = NUM / Y = YPOS / X = XPOS
		txa
		pha
		lsr
		lsr
		lsr
		lsr
		tsx
		lda	$102, x
		jsr	hexnib
		pla
		tax
		inx
		pla
		
hexnib:		clc		; A = NUM / Y = YPOS / X = XPOS

		pha
		lda	ver_tab_lo, y
		sta	ptr
		lda	ver_tab_hi, y
		adc	#SCREEN_0
		sta	ptr+1
		lda	#5
		sta	cnt
		
		txa
		tay

		clc
		pla
		adc	#<HEX0
		sta	ptr1
		lda	#>HEX0
		adc	#0
		sta	ptr1+1
		
		ldx	#0
hex8_1:		lda	(ptr1, x)
		sta	(ptr, x)
		
		clc
		lda	ptr
		adc	#40
		sta	ptr
		lda	ptr+1
		adc 	#0
		sta	ptr+1
		
		clc
		lda	ptr1
		adc	#16
		sta	ptr1
		lda	ptr1+1
		adc 	#0
		sta	ptr1+1
		
		dec	cnt
		bne	hex8_1
		rts
		
			
ver_tab_lo:	.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		
ver_tab_hi:	.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		.word 0, 0, 0, 0, 0, 0, 0, 0
		
HEX0:		.BYTE	%10000000,%10100010,%10000000,%10000000,%10001000,%10000000,%10000000,%10000000
		.BYTE	%10000000,%10000000,%10000000,%10000000,%10000000,%10000010,%10000000,%10000000 
HEX1:		.BYTE	%10001000,%10000010,%10101000,%10101000,%10001000,%10001010,%10001010,%10101000
		.BYTE	%10001000,%10001000,%10001000,%10001000,%10001010,%10001000,%10001010,%10001010 
HEX2:		.BYTE	%10001000,%10100010,%10000000,%10000000,%10000000,%10000000,%10000000,%10101000
		.byte	%10000000,%10000000,%10000000,%10000010,%10001010,%10001000,%10000000,%10000000
HEX3:		.BYTE	%10001000,%10100010,%10001010,%10101000,%10101000,%10101000,%10001000,%10101000
		.byte	%10001000,%10101000,%10001000,%10001000,%10001010,%10001000,%10001010,%10001010
HEX4:		.BYTE	%10000000,%10000000,%10000000,%10000000,%10101000,%10000000,%10000000,%10101000
		.BYTE	%10000000,%10000000,%10001000,%10000000,%10100000,%10000010,%10000000,%10001010
	
		.include "dsplist.a65"
